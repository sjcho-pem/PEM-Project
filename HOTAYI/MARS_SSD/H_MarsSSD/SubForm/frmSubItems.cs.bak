		public frmSubItems()
		{
			InitializeComponent();
			tmrSubItems.Start();
			this.Size = new Size(624, 881);
			richMainMonitor.BackColor = Color.White;


			//Log Class 초기화
			UI.Logs.LogMessageHandled += new UILog.LogMessageHandler(LogMessage);
			UI.Logs.ChangeLogFilePreName("MachineName");// Now Project Name ( ex:UI_BASE )
			UI.Logs.ChangeLogFolderName(@"LOG\MMI\"); // same default
			UI.Logs.ChangeLogExt("log");        // same default.
			UI.Logs.Write(LOGPART.SYS, "Program Start !!");
		}

		#region [ Event Function ]
		private	void	LogMessage(string msg)
		{
			try
			{
				this.InvokeIfNeededC(() => RichTextBoxUpdate(msg));
			}
			catch (Exception ex)
			{
				UI.Logs.Write(LOGPART.EX, string.Format("Message : {0}\nStack trace : {1}", ex.Message, ex.StackTrace));
			}
		}

		private	void	RichTextBoxUpdate(string msg)
		{
			try
			{
				if (this.IsDisposed	== true)			return;

				// MMI 로그 출력 TextBox Clear, 메모리 문제 발생 예방
				if (richMainMonitor.Lines.Length > 1001)
					richMainMonitor.Clear();

				richMainMonitor.AppendText(msg + "\n");
				richMainMonitor.ScrollToCaret();
			}
			catch (Exception ex)
			{
				UI.Logs.Write(LOGPART.EX, string.Format("Message : {0}\nStack trace : {1}", ex.Message, ex.StackTrace));
			}
		}
		#endregion

		#region [ timmer Function ]
		private	void	tmrSubItems_Tick(object sender, EventArgs e)
		{
			try
			{
				UpdateControlEnable();
				UpdateLamp();
				UpdateControlBlink();
				UpdateState();
				UpdateYield();
				UpdateBtnDown();
			}
			catch (Exception ex)
			{
				UI.Logs.Write(LOGPART.EX, string.Format("Message : {0}\nStack trace : {1}", ex.Message, ex.StackTrace));
			}
		}

		#endregion

		#region [ Button Event ]
		private	void	btnRun_Click(object sender, EventArgs e)
		{
			try
			{
				if (SM.SHM.GetUseSkipData(USESKIP.Safety) == true  &&  SM.SHM.IsBitData(BIT.KeyLockAuto) == false)
				{
				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OK, Language.languageDefault.MB_Info, Language.languageDefault.MB_KeyLockManual);
				   	 if (pMsgConfirm.ShowDialog() == DialogResult.OK)		return;
				}
                
				if (SM.SHM.GetUseSkipData(USESKIP.TopInspection) == false || SM.SHM.GetUseSkipData(USESKIP.BtmInspection) == false)
				{
				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OKCancel, Language.languageDefault.MB_Confirmation, "Top or Bottom Inspection Option is Off" + Environment.NewLine +" Do you want to Run it? ");
				   	 if (pMsgConfirm.ShowDialog() == DialogResult.Cancel)		return;
				}
                
				if (SM.SHM.GetUseSkipData(USESKIP.UseMES) == false )
				{
				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OKCancel, Language.languageDefault.MB_Confirmation, "MES USE Option is Off" + Environment.NewLine +"Do you want to Run it? ");
				   	if (pMsgConfirm.ShowDialog() == DialogResult.Cancel)		return;
				}

                if (SM.SHM.GetUseSkipData(USESKIP.DRYRUN) == true)
                {
				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OKCancel, Language.languageDefault.MB_Confirmation, "Dry run option is on." + Environment.NewLine +" Do you want to Run it?");
				    if (pMsgConfirm.ShowDialog() == DialogResult.Cancel)			return;
                }
                else if (SM.SHM.GetUseSkipData(USESKIP.TrayBypass) == true)
                {
                    if (IsMachineEmpty() == true)
                    {
                        frmMessageBox pMsgError = new frmMessageBox(frmMessageBox.teButtons.OK, Language.languageDefault.MB_Confirmation, "Tray Bypass Option is cannot be used " + Environment.NewLine +"when there is No Product.");
				        pMsgError.ShowDialog();
                        return;
                    }

				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OKCancel, Language.languageDefault.MB_Confirmation, "Tray Bypass option is on." + Environment.NewLine +" Do you want to Run it?");
				    if (pMsgConfirm.ShowDialog() == DialogResult.Cancel)			return;
                }
                else
                {
				    frmMessageBox pMsg = new frmMessageBox(frmMessageBox.teButtons.OKCancel, Language.languageDefault.MB_Confirmation, Language.languageDefault.MB_AutoRunStart);
				    if (pMsg.ShowDialog() == DialogResult.Cancel)			return;
                }

				if (SM.SHM.GetUseSkipData(USESKIP.TopInspection) == true  && 
					SM.SHM.IsBitData(BIT.TopInspConnect) == false)
				{
				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OK, Language.languageDefault.MB_Confirmation, "Please Check Top Inspection PC Connect");
				   	 if (pMsgConfirm.ShowDialog() == DialogResult.OK)		return;
				}
				
				if (SM.SHM.GetUseSkipData(USESKIP.BtmInspection) == true  && 
					SM.SHM.IsBitData(BIT.BtmInspConnect) == false)
				{
				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OK, Language.languageDefault.MB_Confirmation, "Please Check Bottom Inspection PC Connect");
				   	 if (pMsgConfirm.ShowDialog() == DialogResult.OK)		return;
				}

				if (SM.SHM.GetUseSkipData(USESKIP.InspDebug) == true  && 
					SM.SHM.IsUsePart(teUsePartName.Insp2, teUsePartMode.Load) == true)
				{
				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OK, Language.languageDefault.MB_Confirmation, "Dubug Mode Use Only Plate1, Please Check Use/Skip Option");
				   	 if (pMsgConfirm.ShowDialog() == DialogResult.OK)		return;
				}
                
				if (SM.SHM.IsUsePart(teUsePartName.Insp1, teUsePartMode.Load) == false  &&
					SM.SHM.IsUsePart(teUsePartName.Insp2, teUsePartMode.Load) == false )
				{
				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OK, Language.languageDefault.MB_Confirmation, "Plate1,2 Use option is off. Do you want to Run it?");
				   	 if (pMsgConfirm.ShowDialog() == DialogResult.Cancel)		return;
				}
                if (SM.SHM.GetUseSkipData(USESKIP.TopInspection) == false || SM.SHM.GetUseSkipData(USESKIP.BtmInspection) == false )
				{
				    frmMessageBox pMsgConfirm = new frmMessageBox(frmMessageBox.teButtons.OKCancel, Language.languageDefault.MB_Confirmation, "Top or Bottom Inspection Option is Off. Do you want to Run it? ");
				   	 if (pMsgConfirm.ShowDialog() == DialogResult.Cancel)		return;
				}
				

				SM.SHM.SetButtonNum(BUTTON.START);

				UI.Logs.Write(LOGPART.SYS, "Auto Run Start Button Click");
			}
			catch (Exception ex)
			{
				UI.Logs.Write(LOGPART.EX, string.Format("Message : {0}\nStack trace : {1}", ex.Message, ex.StackTrace));
			}
		}

