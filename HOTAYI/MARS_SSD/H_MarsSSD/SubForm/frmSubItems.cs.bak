		private void	btnLotInfo_Click(object sender, EventArgs e)
		{
			try
			{
				if (UI.Barcode.ShowDialog() == DialogResult.OK)
				{
					int nrt	= GetRecipeNoFromPartNo(SDm.Read(eSDM.TCardPartNo));
					
					if (nrt == -2)
					{
						frmSetRecipe	pup	= new frmSetRecipe(SDm.Read(eSDM.TCardPartNo));
						if (pup.ShowDialog() == DialogResult.Cancel)
						{
							return;
						}

						nrt	= GetRecipeNoFromPartNo(SDm.Read(eSDM.TCardPartNo));
					}

					if (nrt < 0)
					{
						frmMessageBox	pup	= new frmMessageBox(frmMessageBox.teButtons.OK, Language.languageDefault.MB_Error, "Failed to find Recipe No.");
						pup.ShowDialog();
						return;
					}

					if (SM.SHM.GetUseSkipData(USESKIP.DRYRUN) == true  ||
						NDm.Read(eNDM.MESOnline) == (int)teMesMode.Offline)
					{
						frmMessageBox	msg	= new frmMessageBox(frmMessageBox.teButtons.OKCancel, Language.languageDefault.MB_Question, "Do you want to enter the number of trays?");
						if (msg.ShowDialog() == DialogResult.OK)
						{
							Label	lb	= new Label();
							lb.Text	= NDm.Read(eNDM.SimTrayCnt).ToString();
							frmKeyPad	keynum	= new frmKeyPad(lb, lb.Text, KeyPadType.unsigned);
							if (keynum.ShowDialog() == DialogResult.OK)
							{
								NDm.Write(eNDM.SimTrayCnt, int.Parse(lb.Text));
							}
						}
					}

					SM.SHM.SetButtonParams(NDm.Read(eNDM.OldRecipeIdx), nrt, false);
					SM.SHM.SetButtonNum(BUTTON.RECIPE_CHANGE);
				}
			}
			catch (Exception ex)
			{
				UI.Logs.Write(LOGPART.EX, string.Format("Message : {0}\nStack trace : {1}", ex.Message, ex.StackTrace));
			}
		}

