using System;
using System.Drawing;
using System.Windows.Forms;

namespace MarsSSD
{
    public partial class frmData_SDm : Form
    {        
        public frmData_SDm()
        {
            InitializeComponent();
            InitialXML();
            InitialGrid();
            InitialDMData();

            tmrDm.Start();
            //UpdateDm();
        }

        #region [ Variables ]

        private XML XMLSDm = new XML();
        private string strDmCol0 = "DataMemoryName";
        
        public string[] sDm = new string[Define.MAX_DM_NUM];
        #endregion

        #region [ Event Function ]

        #endregion

        #region [ Timmer Function ]

        private void tmrDm_Tick(object sender, EventArgs e)
        {

            if (!chkSDmEnable.Checked && !chkSDmMod.Checked)
            {
                SM.SHM.GetSDMData(ref sDm);
                UpdateSDm();
            }
        }
        #endregion

        #region [ CheckBox Event ]

        // SDM Modify CheckBox
        private void chkSDmMod_CheckedChanged(object sender, EventArgs e)
        {
            if (chkSDmMod.Checked)
            {
                chkSDmMod.ForeColor = Color.Red;
                chkSDmEnable.Enabled = false;

                this.tbColumnSDmName.ReadOnly = false;
            }
            else
            {
                chkSDmMod.ForeColor = Properties.Settings.Default._DarkOliveGreen;
                chkSDmEnable.Enabled = true;
                this.tbColumnSDmName.ReadOnly = true;

                XMLSDm.UpdateData();
            }
        }

        // SDM Enable CheckBox
        private void chkSDmEnable_CheckedChanged(object sender, EventArgs e)
        {
            if (chkSDmEnable.Checked)
            {
                SM.SHM.SetBitData(BIT.DataEdit, true);
                chkSDmEnable.ForeColor = Color.Red;
                chkSDmMod.Enabled = false;
                this.tbColumnSDmValue.ReadOnly = false;
            }
            else
            {
                SM.SHM.SetBitData(BIT.DataEdit, false);
                chkSDmEnable.ForeColor = Properties.Settings.Default._DarkOliveGreen;
                chkSDmMod.Enabled = true;
                this.tbColumnSDmValue.ReadOnly = true;
            }
        }
        #endregion

        #region [ Button Event ]

        #endregion

        #region [ Grid Setting ]

        #region -Function
        private void InitialGrid()
        {
            // SDM 초기화
            for (int i = 0; i < Define.MAX_DM_NUM; i++)
                this.dgridSDm.Rows.Add(i, XMLSDm.ReadDataTable(i, strDmCol0), 0);

            this.dgridSDm.RowTemplate.Height = 35;

            this.tbColumnSDmName.ReadOnly = true;
            this.tbColumnSDmValue.ReadOnly = true;
        }

        // SDM
        private void UpdateSDm()
        {
            for (int i = 0; i < Define.MAX_DM_NUM; i++)
            {
                this.dgridSDm.Rows[i].Cells[2].Value = Convert.ToString(sDm[i]);
            }
        }

        // SDM
        private void UpdateSDm(int idx)
        {
            this.dgridSDm.Rows[idx].Cells[2].Value = Convert.ToString(sDm[idx]);
        }
        #endregion

        #region - Event
        // SDM
        private void dgridSDm_CellValueChanged(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex == -1) return;
            if (!chkSDmEnable.Checked && !chkSDmMod.Checked) return;

            string strNewValue = "";
            if (this.dgridSDm[e.ColumnIndex, e.RowIndex].FormattedValue.ToString() == null)
                strNewValue = "";
            else
                strNewValue = this.dgridSDm[e.ColumnIndex, e.RowIndex].FormattedValue.ToString();

            if (!dgridSDm.Columns[1].ReadOnly)
            {
                XMLSDm.WriteDataTable(e.RowIndex, strDmCol0, strNewValue);
            }
            else if (!dgridSDm.Columns[2].ReadOnly)
            {
                SetSDm(e.RowIndex, strNewValue);
                UpdateSDm(e.RowIndex);
                SDm.Write((eSDM)e.RowIndex, strNewValue);
            }
        }
        
        private void dgridSDm_ColumnHeaderMouseDoubleClick(object sender, DataGridViewCellMouseEventArgs e)
        {
            if (!chkSDmMod.Checked ) return;
            string strMsg = "";
            if (Program.m_Languageidx == (int)LAN_MODE.ENG)
                strMsg = "Do you want to update the data name?\r\n(Initialize the existing name)";
            else if (Program.m_Languageidx == (int)LAN_MODE.KOR)
                strMsg = "데이터이름을 업데이트하시겠습니까?\r\n(기존 이름은 초기화됩니다.)";

            frmMessageBox pMsg = new frmMessageBox(true, Language.languageDefault.MB_Confirmation, strMsg);
            if (pMsg.ShowDialog() == DialogResult.Cancel) return;


            for (int i = 0; i < Define.MAX_DM_NUM; i++)
            {
                if (EnumHelper.GetDescription((eSDM)i) == i.ToString())
                    XMLSDm.WriteDataTable(i, strDmCol0, " ");
                else
                    XMLSDm.WriteDataTable(i, strDmCol0, EnumHelper.GetDescription((eSDM)i));

                dgridSDm.Rows[i].Cells[1].Value = XMLSDm.ReadDataTable(i, strDmCol0);
            }

            XMLSDm.UpdateData();
            XMLSDm.RefillData();
        }

        #endregion
        #endregion

        #region [ Function ]

        #region - Private Function

        private void InitialXML()
        {
            XMLSDm.Initializ("SDataMemory");
        }

        private void InitialDMData()
        {
            for (int i = 0; i < Define.MAX_DM_NUM; i++)
            {
                // SDM
                sDm[i] = "";
            }
        }

        // SDM
        private void SetSDm(int idx, string value)
        {
            sDm[idx] = value;
        }
        #endregion

        #region - Public Function

        // SDM
        public string GetSDmData(eSDM data)
        {
            int num = Convert.ToInt32(data);

            if (num >= Define.MAX_DM_NUM)
                num = Define.MAX_DM_NUM - 1;
            if (num < 0)
                num = 0;

            return (sDm[num]);
        }

        // SDM
        public string GetSDmData(int num)
        {
            if (num >= Define.MAX_DM_NUM)
                num = Define.MAX_DM_NUM - 1;
            if (num < 0)
                num = 0;

            return (sDm[num]);
        }

        public void UpdateCheckBox(PW_MODE Password_Now)
        {
            switch (Password_Now)
            {
                case PW_MODE.OPER:
                case PW_MODE.ENG:
                    chkSDmEnable.Checked = false;
                    chkSDmMod.Checked = false;

                    chkSDmEnable.Enabled = false;
                    chkSDmMod.Enabled = false;

                    break;

                case PW_MODE.PRO:
                    if (!chkSDmEnable.Checked)
                        chkSDmMod.Enabled = true;
                    else
                        chkSDmMod.Enabled = false;

                    if (!chkSDmMod.Checked)
                        chkSDmEnable.Enabled = true;
                    else
                        chkSDmEnable.Enabled = false;

                    break;
            }
        }

        public bool IsWorking()
        {
            if (chkSDmEnable.Checked || chkSDmMod.Checked)
                return true;

            return false;
        }

        public void WorkEnd()
        {
            if (chkSDmEnable.Checked)
                chkSDmEnable.Checked = false;
            if (chkSDmMod.Checked)
                chkSDmMod.Checked = false;
        }

        public void DisableWork()
        {
            if (chkSDmEnable.Enabled)
                chkSDmEnable.Enabled = false;
            if (chkSDmMod.Enabled)
                chkSDmMod.Enabled = false;
        }

        public void EnableWork()
        {
            if (!chkSDmEnable.Enabled)
                chkSDmEnable.Enabled = true;
            if (!chkSDmMod.Enabled)
                chkSDmMod.Enabled = true;
        }

        // SDM
        public void SetNDMNameValue(int rowIndex, string strNewValue)
        {
            XMLSDm.WriteDataTable(rowIndex, strDmCol0, strNewValue);
        }
        #endregion

        #region - Language Function 

        public void SetLanguageText()
        {
            chkSDmMod.Text = Language.languageDefault.NameModify;
            chkSDmEnable.Text = Language.languageDefault.Enable;

			dgridSDm.Columns[0].HeaderText = Language.languageDefault.DGRID_HD_No;
			dgridSDm.Columns[1].HeaderText = Language.languageDefault.DGRID_HD_IntegerData;
			dgridSDm.Columns[2].HeaderText = Language.languageDefault.DGRID_HD_Value;
        }

        #endregion

        #endregion
    }
}

