<UserControl x:Class="H_MarsSSD.ucTraynPartFigure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:MachineAni="clr-namespace:PMN.Control.WPF.MachineAni;assembly=PMN.Control.WPF.MachineAni" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="700">

    <Grid x:Name="gdTraynPart">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="0.2*"/>
        </Grid.RowDefinitions>
        <MachineAni:ucFigureArray x:Name="figure" Width="550" Height="350" _FigureArrayMouseLeftDownEvent="FigureArrayMouseLeftDownEvent" _FigureArrayMouseEnterEvent="FigureFigureArrayMouseEnterEvent" Grid.RowSpan="1" Grid.Row="0" _CountCol="25" _CountRow="2" Margin="0" _InsideGap="4,8" _InsideMargin="10" _BorderThicknessDefaultInside="1" _IndexIncDir="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnExist" Grid.Column="0" Content="Product Exist" FontSize="16" FontWeight="Bold" BorderThickness="2" Margin="10" Click="BtnExist_Click"/>
            <Button x:Name="btnDelete" Grid.Column="1" Content="Product &#x0a; Delete" FontSize="16" BorderThickness="2" FontWeight="Bold" Margin="10" Click="BtnDelete_Click"/>
            <Button x:Name="btnSave" Grid.Column="2" Content="Save" FontSize="16" BorderThickness="2" FontWeight="Bold" Margin="10" Click="BtnSave_Click"/>
            <Button x:Name="btnClose" Grid.Column="3" Content="Close" FontSize="16" FontWeight="Bold" BorderThickness="2" Margin="10" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</UserControl>
